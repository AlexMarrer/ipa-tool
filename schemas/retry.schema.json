{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPA Assistant – Freigabe weiterer Versuche analyses/<snapshotId>/retry-<n>.json (spec.md §9.8, §12.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "requestedAt"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "snapshotId": { "type": "string", "pattern": "^S[0-9]{6}$" },
    "requestedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
