{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPA Assistant – Versuchsergebnis attempt-<n>/outcome.json (spec.md §9.9)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "runId", "attempt", "startedAt", "endedAt", "outcome", "errorCode", "message"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "snapshotId": { "type": ["string", "null"], "pattern": "^S[0-9]{6}$" },
    "runId": { "type": "string", "pattern": "^R[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "startedAt": { "$ref": "#/definitions/timestamp" },
    "endedAt": { "$ref": "#/definitions/timestamp" },
    "outcome": {
      "type": "string",
      "enum": ["success", "claude_error", "invalid_response", "validation_failed", "input_too_large", "interrupted"]
    },
    "errorCode": {
      "type": ["string", "null"],
      "enum": [
        "not_found",
        "not_executable",
        "timeout",
        "nonzero_exit",
        "invalid_envelope",
        "error_result",
        "missing_structured_output",
        "schema_invalid",
        "evidence_invalid",
        "rule_violation",
        null
      ]
    },
    "message": { "type": ["string", "null"], "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "enum": ["success", "input_too_large", "interrupted"] } } },
      "then": { "properties": { "errorCode": { "type": "null" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "claude_error" } } },
      "then": {
        "properties": { "errorCode": { "type": "string", "enum": ["not_found", "not_executable", "timeout", "nonzero_exit", "error_result"] } }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "invalid_response" } } },
      "then": { "properties": { "errorCode": { "type": "string", "enum": ["invalid_envelope", "missing_structured_output"] } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "validation_failed" } } },
      "then": { "properties": { "errorCode": { "type": "string", "enum": ["schema_invalid", "evidence_invalid", "rule_violation"] } } }
    }
  ],
  "definitions": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
