{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPA Assistant – Journal-Eingabe journal/runs/<runId>/input.json (spec.md §9.10, §15)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "promptVersion",
    "day",
    "timezone",
    "analyses",
    "evidence",
    "commits",
    "notes",
    "context",
    "timeSummary",
    "openItems",
    "allowedEvidenceIds"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "purpose": { "type": "string", "const": "journal" },
    "promptVersion": { "type": "string", "minLength": 1 },
    "day": { "$ref": "#/definitions/day" },
    "timezone": { "type": "string", "minLength": 1 },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["snapshotId", "dayAttribution", "observedPeriod", "derived", "statusChanges"],
        "properties": {
          "snapshotId": { "$ref": "#/definitions/snapshotId" },
          "dayAttribution": { "type": "string", "enum": ["day", "unclear"] },
          "observedPeriod": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "$ref": "#/definitions/timestampOrNull" },
              "to": { "$ref": "#/definitions/timestamp" }
            }
          },
          "derived": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/derived" }] },
          "statusChanges": { "type": "array", "items": { "$ref": "#/definitions/statusChange" } }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind", "path", "commit", "snapshotId", "omitted", "binary", "fresh"],
        "properties": {
          "ref": { "$ref": "#/definitions/qualifiedEvidence" },
          "kind": { "type": "string", "enum": ["commit_message", "state_delta", "test_report"] },
          "path": { "type": ["string", "null"], "minLength": 1 },
          "commit": { "$ref": "#/definitions/objectIdOrNull" },
          "snapshotId": { "$ref": "#/definitions/snapshotId" },
          "omitted": { "type": "boolean" },
          "binary": { "type": "boolean" },
          "fresh": { "type": ["boolean", "null"] }
        }
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha", "snapshotId", "committerDate", "authoredByConfiguredUser", "messageRef", "message"],
        "properties": {
          "sha": { "$ref": "#/definitions/objectId" },
          "snapshotId": { "$ref": "#/definitions/snapshotId" },
          "committerDate": { "$ref": "#/definitions/timestamp" },
          "authoredByConfiguredUser": { "type": "boolean" },
          "messageRef": { "type": ["string", "null"], "pattern": "^S[0-9]{6}:E[0-9]{3,}$" },
          "message": { "type": ["string", "null"] }
        }
      }
    },
    "notes": { "type": "array", "items": { "$ref": "#/definitions/note" } },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "content"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]{2,}$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/definitions/sha256" },
          "content": { "type": "string" }
        }
      }
    },
    "timeSummary": { "$ref": "#/definitions/timeSummary" },
    "openItems": { "$ref": "#/definitions/openItems" },
    "allowedEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/ref" }
    }
  },
  "definitions": {
    "day": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "snapshotId": { "type": "string", "pattern": "^S[0-9]{6}$" },
    "noteId": { "type": "string", "pattern": "^N[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$" },
    "qualifiedEvidence": { "type": "string", "pattern": "^S[0-9]{6}:E[0-9]{3,}$" },
    "ref": { "type": "string", "pattern": "^(S[0-9]{6}:E[0-9]{3,}|N[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}|C[0-9]{2,})$" },
    "refs": { "type": "array", "items": { "$ref": "#/definitions/ref" } },
    "objectId": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
    "objectIdOrNull": { "type": ["string", "null"], "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "minutes": { "type": "integer", "minimum": 1 },
    "basis": { "type": "string", "enum": ["measured", "estimated"] },
    "timeOfDayOrNull": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "timestampOrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "text": { "type": "string", "minLength": 1 },
    "textOrNull": { "type": ["string", "null"], "minLength": 1 },
    "stage": { "type": "string", "enum": ["clean", "staged", "unstaged", "mixed", "untracked"] },
    "statusChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob", "from", "to", "commit", "attribution", "previousEvidence"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "blob": { "$ref": "#/definitions/objectIdOrNull" },
        "from": { "$ref": "#/definitions/stage" },
        "to": { "type": "string", "enum": ["clean", "staged", "unstaged", "mixed", "untracked", "committed"] },
        "commit": { "$ref": "#/definitions/objectIdOrNull" },
        "attribution": { "type": "string", "enum": ["documented", "baseline", "unclear"] },
        "previousEvidence": { "type": "array", "items": { "$ref": "#/definitions/qualifiedEvidence" } }
      }
    },
    "derived": {
      "description": "Analyse-Ausgabe (spec.md §9.7) mit qualifizierten Beleg-IDs. Abgeleitete Aussagen sind keine eigenständigen Belege.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "implemented", "decisions", "problems", "tests", "contradictions", "unknowns"],
      "properties": {
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "evidence"],
          "properties": { "text": { "$ref": "#/definitions/text" }, "evidence": { "$ref": "#/definitions/refs" } }
        },
        "implemented": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description", "evidence"],
            "properties": {
              "title": { "$ref": "#/definitions/text" },
              "description": { "$ref": "#/definitions/text" },
              "evidence": { "$ref": "#/definitions/refs" }
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description", "rationale", "alternatives", "evidence"],
            "properties": {
              "title": { "$ref": "#/definitions/text" },
              "description": { "$ref": "#/definitions/text" },
              "rationale": { "$ref": "#/definitions/textOrNull" },
              "alternatives": { "type": "array", "items": { "$ref": "#/definitions/text" } },
              "evidence": { "$ref": "#/definitions/refs" }
            }
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description", "cause", "solution", "evidence"],
            "properties": {
              "title": { "$ref": "#/definitions/text" },
              "description": { "$ref": "#/definitions/text" },
              "cause": { "$ref": "#/definitions/textOrNull" },
              "solution": { "$ref": "#/definitions/textOrNull" },
              "evidence": { "$ref": "#/definitions/refs" }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "result", "evidence"],
            "properties": {
              "description": { "$ref": "#/definitions/text" },
              "result": { "type": "string", "enum": ["passed", "failed", "unknown"] },
              "evidence": { "$ref": "#/definitions/refs" }
            }
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "evidence"],
            "properties": { "description": { "$ref": "#/definitions/text" }, "evidence": { "$ref": "#/definitions/refs" } }
          }
        },
        "unknowns": { "type": "array", "items": { "$ref": "#/definitions/text" } }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "type", "text", "activityDay", "recordedAt", "time", "delay", "reason", "alternatives", "cause", "solution", "refs"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "id": { "$ref": "#/definitions/noteId" },
        "type": { "type": "string", "enum": ["general", "activity", "problem", "decision", "insight", "plan"] },
        "text": { "$ref": "#/definitions/text" },
        "activityDay": { "$ref": "#/definitions/day" },
        "recordedAt": { "$ref": "#/definitions/timestamp" },
        "time": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["minutes", "basis", "start", "end"],
          "properties": {
            "minutes": { "$ref": "#/definitions/minutes" },
            "basis": { "$ref": "#/definitions/basis" },
            "start": { "$ref": "#/definitions/timeOfDayOrNull" },
            "end": { "$ref": "#/definitions/timeOfDayOrNull" }
          }
        },
        "delay": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["minutes", "basis"],
          "properties": { "minutes": { "$ref": "#/definitions/minutes" }, "basis": { "$ref": "#/definitions/basis" } }
        },
        "reason": { "$ref": "#/definitions/textOrNull" },
        "alternatives": { "type": "array", "items": { "$ref": "#/definitions/text" } },
        "cause": { "$ref": "#/definitions/textOrNull" },
        "solution": { "$ref": "#/definitions/textOrNull" },
        "refs": { "type": "array", "items": { "$ref": "#/definitions/qualifiedEvidence" } }
      }
    },
    "minuteSums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measuredMinutes", "estimatedMinutes"],
      "properties": { "measuredMinutes": { "$ref": "#/definitions/count" }, "estimatedMinutes": { "$ref": "#/definitions/count" } }
    },
    "timeSummary": {
      "description": "Deterministisch aus Notizen (spec.md §15, I-07): gemessen und geschätzt getrennt, Verzögerungen separat, Planungsnotizen nicht summiert.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "totals", "planned", "delays", "delayTotals", "notesWithoutTime"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["noteId", "noteType", "minutes", "basis", "start", "end", "counted", "withheld"],
            "properties": {
              "noteId": { "$ref": "#/definitions/noteId" },
              "noteType": { "type": "string", "enum": ["general", "activity", "problem", "decision", "insight", "plan"] },
              "minutes": { "$ref": "#/definitions/minutes" },
              "basis": { "$ref": "#/definitions/basis" },
              "start": { "$ref": "#/definitions/timeOfDayOrNull" },
              "end": { "$ref": "#/definitions/timeOfDayOrNull" },
              "counted": { "type": "boolean" },
              "withheld": { "type": "boolean" }
            }
          }
        },
        "totals": { "$ref": "#/definitions/minuteSums" },
        "planned": { "$ref": "#/definitions/minuteSums" },
        "delays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["noteId", "minutes", "basis"],
            "properties": {
              "noteId": { "$ref": "#/definitions/noteId" },
              "minutes": { "$ref": "#/definitions/minutes" },
              "basis": { "$ref": "#/definitions/basis" }
            }
          }
        },
        "delayTotals": { "$ref": "#/definitions/minuteSums" },
        "notesWithoutTime": { "type": "array", "items": { "$ref": "#/definitions/noteId" } }
      }
    },
    "openItems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyses", "gaps"],
      "properties": {
        "analyses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["snapshotId", "status"],
            "properties": {
              "snapshotId": { "$ref": "#/definitions/snapshotId" },
              "status": { "type": "string", "enum": ["pending", "failed", "blocked", "exhausted", "skipped"] }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["snapshotId", "type", "detail"],
            "properties": {
              "snapshotId": { "type": ["string", "null"], "pattern": "^S[0-9]{6}$" },
              "type": {
                "type": "string",
                "enum": ["rebaseline", "previous_state_unavailable", "halt_detected", "halt", "run_failed", "no_capture", "invalid_notes", "withheld"]
              },
              "detail": { "$ref": "#/definitions/text" }
            }
          }
        }
      }
    }
  }
}
