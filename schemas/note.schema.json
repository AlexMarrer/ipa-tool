{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPA Assistant – Notiz, eine Zeile in notes/<activityDay>.jsonl (spec.md §9.5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "type",
    "text",
    "activityDay",
    "recordedAt",
    "time",
    "delay",
    "reason",
    "alternatives",
    "cause",
    "solution",
    "refs"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^N[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$" },
    "type": { "type": "string", "enum": ["general", "activity", "problem", "decision", "insight", "plan"] },
    "text": { "type": "string", "minLength": 1 },
    "activityDay": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "recordedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "time": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["minutes", "basis", "start", "end"],
      "properties": {
        "minutes": { "$ref": "#/definitions/minutes" },
        "basis": { "$ref": "#/definitions/basis" },
        "start": { "$ref": "#/definitions/timeOfDayOrNull" },
        "end": { "$ref": "#/definitions/timeOfDayOrNull" }
      },
      "if": { "properties": { "start": { "type": "null" } } },
      "then": { "properties": { "end": { "type": "null" } } },
      "else": { "properties": { "end": { "type": "string" } } }
    },
    "delay": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["minutes", "basis"],
      "properties": {
        "minutes": { "$ref": "#/definitions/minutes" },
        "basis": { "$ref": "#/definitions/basis" }
      }
    },
    "reason": { "$ref": "#/definitions/textOrNull" },
    "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "cause": { "$ref": "#/definitions/textOrNull" },
    "solution": { "$ref": "#/definitions/textOrNull" },
    "refs": { "type": "array", "items": { "type": "string", "pattern": "^S[0-9]{6}:E[0-9]{3,}$" } }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "not": { "const": "decision" } } } },
      "then": { "properties": { "reason": { "type": "null" }, "alternatives": { "type": "array", "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "type": { "not": { "const": "problem" } } } },
      "then": { "properties": { "cause": { "type": "null" }, "solution": { "type": "null" } } }
    }
  ],
  "definitions": {
    "minutes": { "type": "integer", "minimum": 1 },
    "basis": { "type": "string", "enum": ["measured", "estimated"] },
    "timeOfDayOrNull": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "textOrNull": { "type": ["string", "null"], "minLength": 1 }
  }
}
