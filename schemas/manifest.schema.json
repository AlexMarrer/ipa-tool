{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPA Assistant – Snapshot-Manifest (spec.md §9.3, §9.4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "repositoryId",
    "kind",
    "previousSnapshotId",
    "capturedAt",
    "observedPeriod",
    "git",
    "analysisRequired",
    "commits",
    "fileStates",
    "evidence",
    "statusChanges",
    "testReports",
    "filterDecisions",
    "gaps",
    "stability",
    "tool"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "snapshotId": { "$ref": "#/definitions/snapshotId" },
    "repositoryId": { "type": "string", "pattern": "^[a-z0-9-]{1,32}-[0-9a-f]{6}$" },
    "kind": { "type": "string", "enum": ["baseline", "work"] },
    "previousSnapshotId": { "type": ["string", "null"], "pattern": "^S[0-9]{6}$" },
    "capturedAt": { "$ref": "#/definitions/timestamp" },
    "observedPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/definitions/timestampOrNull" },
        "to": { "$ref": "#/definitions/timestamp" }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "head", "indexFingerprint", "statusFingerprint"],
      "properties": {
        "branch": { "type": ["string", "null"], "minLength": 1 },
        "head": { "$ref": "#/definitions/objectIdOrNull" },
        "indexFingerprint": { "$ref": "#/definitions/sha256" },
        "statusFingerprint": { "$ref": "#/definitions/sha256" }
      }
    },
    "analysisRequired": { "type": "boolean" },
    "commits": { "type": "array", "items": { "$ref": "#/definitions/commit" } },
    "fileStates": { "type": "array", "items": { "$ref": "#/definitions/fileState" } },
    "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidence" } },
    "statusChanges": { "type": "array", "items": { "$ref": "#/definitions/statusChange" } },
    "testReports": { "type": "array", "items": { "$ref": "#/definitions/testReport" } },
    "filterDecisions": { "type": "array", "items": { "$ref": "#/definitions/filterDecision" } },
    "gaps": { "type": "array", "items": { "$ref": "#/definitions/gap" } },
    "stability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "stable"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 1 },
        "stable": { "type": "boolean", "const": true }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "const": "ipa-assistant" },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "snapshotId": { "type": "string", "pattern": "^S[0-9]{6}$" },
    "evidenceId": { "type": "string", "pattern": "^E[0-9]{3,}$" },
    "evidenceIdOrNull": { "type": ["string", "null"], "pattern": "^E[0-9]{3,}$" },
    "qualifiedEvidence": { "type": "string", "pattern": "^S[0-9]{6}:E[0-9]{3,}$" },
    "objectId": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
    "objectIdOrNull": { "type": ["string", "null"], "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256OrNull": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "timestampOrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "repoPath": { "type": "string", "minLength": 1 },
    "repoPathOrNull": { "type": ["string", "null"], "minLength": 1 },
    "snapshotFileOrNull": { "type": ["string", "null"], "pattern": "^content/[^\\\\]+$" },
    "stage": { "type": "string", "enum": ["clean", "staged", "unstaged", "mixed", "untracked"] },
    "omitReason": {
      "type": "string",
      "enum": ["excluded", "secret_suspected", "binary", "file_too_large", "snapshot_limit", "unreadable", "symlink"]
    },
    "detectorOrNull": {
      "type": ["string", "null"],
      "enum": [
        "private_key",
        "aws_access_key",
        "github_token",
        "slack_token",
        "anthropic_or_openai_key",
        "jwt",
        "url_credentials",
        "assignment",
        "custom",
        null
      ]
    },
    "omission": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "$ref": "#/definitions/omitReason" },
        "rule": { "type": "string", "minLength": 1 },
        "detector": {
          "type": "string",
          "enum": [
            "private_key",
            "aws_access_key",
            "github_token",
            "slack_token",
            "anthropic_or_openai_key",
            "jwt",
            "url_credentials",
            "assignment",
            "custom"
          ]
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "parents",
        "authorDate",
        "committerDate",
        "authoredByConfiguredUser",
        "isMerge",
        "messageEvidence",
        "files"
      ],
      "properties": {
        "sha": { "$ref": "#/definitions/objectId" },
        "parents": { "type": "array", "items": { "$ref": "#/definitions/objectId" } },
        "authorDate": { "$ref": "#/definitions/timestamp" },
        "committerDate": { "$ref": "#/definitions/timestamp" },
        "authoredByConfiguredUser": { "type": "boolean" },
        "isMerge": { "type": "boolean" },
        "messageEvidence": { "$ref": "#/definitions/evidenceIdOrNull" },
        "files": { "type": "array", "items": { "$ref": "#/definitions/commitFile" } }
      }
    },
    "commitFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "oldPath", "change", "blob", "evidence", "attribution", "coveredBy", "previousEvidence"],
      "properties": {
        "path": { "$ref": "#/definitions/repoPath" },
        "oldPath": { "$ref": "#/definitions/repoPathOrNull" },
        "change": { "type": "string", "enum": ["A", "M", "D", "R", "T", "C"] },
        "blob": { "$ref": "#/definitions/objectIdOrNull" },
        "evidence": { "$ref": "#/definitions/evidenceIdOrNull" },
        "attribution": { "type": ["string", "null"], "enum": ["new", "documented", "baseline", "unclear", null] },
        "coveredBy": { "type": "array", "items": { "$ref": "#/definitions/evidenceId" } },
        "previousEvidence": { "type": "array", "items": { "$ref": "#/definitions/qualifiedEvidence" } }
      }
    },
    "fileState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "stage", "headBlob", "indexBlob", "worktreeBlob", "symlink", "copy", "copyOmitted"],
      "properties": {
        "path": { "$ref": "#/definitions/repoPath" },
        "stage": { "$ref": "#/definitions/stage" },
        "headBlob": { "$ref": "#/definitions/objectIdOrNull" },
        "indexBlob": { "$ref": "#/definitions/objectIdOrNull" },
        "worktreeBlob": { "$ref": "#/definitions/objectIdOrNull" },
        "symlink": { "type": "boolean" },
        "copy": { "$ref": "#/definitions/snapshotFileOrNull" },
        "copyOmitted": {
          "type": ["string", "null"],
          "enum": ["excluded", "secret_suspected", "binary", "file_too_large", "snapshot_limit", "unreadable", "symlink", null]
        }
      }
    },
    "evidence": {
      "oneOf": [
        { "$ref": "#/definitions/diffEvidence" },
        { "$ref": "#/definitions/stateDeltaEvidence" },
        { "$ref": "#/definitions/testReportEvidence" }
      ]
    },
    "diffEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "oldPath", "commit", "file", "bytes", "sha256", "binary", "omitted"],
      "properties": {
        "id": { "$ref": "#/definitions/evidenceId" },
        "kind": { "type": "string", "enum": ["commit_message", "commit_diff", "staged_diff", "unstaged_diff"] },
        "path": { "$ref": "#/definitions/repoPathOrNull" },
        "oldPath": { "$ref": "#/definitions/repoPathOrNull" },
        "commit": { "$ref": "#/definitions/objectIdOrNull" },
        "file": { "$ref": "#/definitions/snapshotFileOrNull" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/sha256OrNull" },
        "binary": { "type": "boolean" },
        "omitted": { "$ref": "#/definitions/omission" }
      }
    },
    "stateDeltaEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "oldPath", "commit", "file", "bytes", "sha256", "binary", "omitted", "fromBlob", "toBlob"],
      "properties": {
        "id": { "$ref": "#/definitions/evidenceId" },
        "kind": { "type": "string", "const": "state_delta" },
        "path": { "$ref": "#/definitions/repoPathOrNull" },
        "oldPath": { "$ref": "#/definitions/repoPathOrNull" },
        "commit": { "$ref": "#/definitions/objectIdOrNull" },
        "file": { "$ref": "#/definitions/snapshotFileOrNull" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/sha256OrNull" },
        "binary": { "type": "boolean" },
        "omitted": { "$ref": "#/definitions/omission" },
        "fromBlob": { "$ref": "#/definitions/objectIdOrNull" },
        "toBlob": { "$ref": "#/definitions/objectIdOrNull" }
      }
    },
    "testReportEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "oldPath", "commit", "file", "bytes", "sha256", "binary", "omitted", "label", "mtime", "fresh"],
      "properties": {
        "id": { "$ref": "#/definitions/evidenceId" },
        "kind": { "type": "string", "const": "test_report" },
        "path": { "$ref": "#/definitions/repoPathOrNull" },
        "oldPath": { "$ref": "#/definitions/repoPathOrNull" },
        "commit": { "$ref": "#/definitions/objectIdOrNull" },
        "file": { "$ref": "#/definitions/snapshotFileOrNull" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/sha256OrNull" },
        "binary": { "type": "boolean" },
        "omitted": { "$ref": "#/definitions/omission" },
        "label": { "type": "string", "minLength": 1 },
        "mtime": { "$ref": "#/definitions/timestamp" },
        "fresh": { "type": "boolean" }
      }
    },
    "statusChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob", "from", "to", "commit", "attribution", "previousEvidence"],
      "properties": {
        "path": { "$ref": "#/definitions/repoPath" },
        "blob": { "$ref": "#/definitions/objectIdOrNull" },
        "from": { "$ref": "#/definitions/stage" },
        "to": { "type": "string", "enum": ["clean", "staged", "unstaged", "mixed", "untracked", "committed"] },
        "commit": { "$ref": "#/definitions/objectIdOrNull" },
        "attribution": { "type": "string", "enum": ["documented", "baseline", "unclear"] },
        "previousEvidence": { "type": "array", "items": { "$ref": "#/definitions/qualifiedEvidence" } }
      }
    },
    "testReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "label", "sha256", "mtime"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "mtime": { "$ref": "#/definitions/timestamp" }
      }
    },
    "filterDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "decision", "reason", "rule", "detector", "line", "evidence"],
      "properties": {
        "path": { "$ref": "#/definitions/repoPathOrNull" },
        "decision": { "type": "string", "enum": ["excluded", "withheld", "omitted"] },
        "reason": { "$ref": "#/definitions/omitReason" },
        "rule": { "type": ["string", "null"], "minLength": 1 },
        "detector": { "$ref": "#/definitions/detectorOrNull" },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "evidence": { "$ref": "#/definitions/evidenceIdOrNull" }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "detail"],
      "properties": {
        "type": { "type": "string", "enum": ["rebaseline", "previous_state_unavailable", "halt_detected"] },
        "detail": { "type": "string" }
      }
    }
  }
}
