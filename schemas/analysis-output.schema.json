{
  "title": "IPA Assistant – Analyse-Ausgabe (spec.md §9.7)",
  "description": "Jede Aussage nennt Beleg-IDs aus allowedEvidenceIds des Eingabepakets. Keine Zeitangaben. Leere Listen bedeuten: nicht erfasst.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "implemented", "decisions", "problems", "tests", "contradictions", "unknowns"],
  "properties": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(E[0-9]{3,}|N[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}|C[0-9]{2,})$" }
        }
      }
    },
    "implemented": {
      "description": "Nur mit mindestens einem state_delta-Beleg mit Inhalt.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "evidence"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(E[0-9]{3,}|N[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}|C[0-9]{2,})$" }
          }
        }
      }
    },
    "decisions": {
      "description": "rationale nur mit einem Notiz- oder Commit-Nachrichten-Beleg, sonst null.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "rationale", "alternatives", "evidence"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "rationale": { "type": ["string", "null"], "minLength": 1 },
          "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(E[0-9]{3,}|N[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}|C[0-9]{2,})$" }
          }
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "cause", "solution", "evidence"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "cause": { "type": ["string", "null"], "minLength": 1 },
          "solution": { "type": ["string", "null"], "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(E[0-9]{3,}|N[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}|C[0-9]{2,})$" }
          }
        }
      }
    },
    "tests": {
      "description": "passed oder failed nur mit einem test_report-Beleg mit fresh true und Inhalt, sonst unknown.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "result", "evidence"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "enum": ["passed", "failed", "unknown"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(E[0-9]{3,}|N[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}|C[0-9]{2,})$" }
          }
        }
      }
    },
    "contradictions": {
      "description": "Mindestens zwei verschiedene Belege pro Widerspruch.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "evidence"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "pattern": "^(E[0-9]{3,}|N[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}|C[0-9]{2,})$" }
          }
        }
      }
    },
    "unknowns": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
