{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPA Assistant – ipa note --json (Paket 09 §4.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "runId",
    "ok",
    "exitCode",
    "outcome",
    "errors",
    "warnings",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "command": {
      "type": "string",
      "const": "note"
    },
    "runId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^R[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "ok": {
      "type": "boolean"
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "unchanged",
        "halted",
        "unstable",
        "lock_held",
        "analysis_failed",
        "outside_window",
        "usage_error",
        "error"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/runError"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/result"
        }
      ]
    }
  },
  "definitions": {
    "runError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noteId",
        "type",
        "activityDay",
        "recordedAt",
        "notePath",
        "time",
        "delay",
        "refs",
        "secretFindings"
      ],
      "properties": {
        "noteId": {
          "type": "string",
          "pattern": "^N[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "general",
            "activity",
            "problem",
            "decision",
            "insight",
            "plan"
          ]
        },
        "activityDay": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "recordedAt": {
          "type": "string"
        },
        "notePath": {
          "type": "string"
        },
        "time": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minutes",
                "basis",
                "start",
                "end"
              ],
              "properties": {
                "minutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "measured",
                    "estimated"
                  ]
                },
                "start": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "end": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "delay": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minutes",
                "basis"
              ],
              "properties": {
                "minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "measured",
                    "estimated"
                  ]
                }
              }
            }
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[0-9]{6}:E[0-9]{3,}$"
          }
        },
        "secretFindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "detector",
              "field"
            ],
            "properties": {
              "detector": {
                "type": "string"
              },
              "field": {
                "type": "string",
                "enum": [
                  "text",
                  "reason",
                  "alternatives",
                  "cause",
                  "solution"
                ]
              }
            }
          }
        }
      }
    }
  }
}
