{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPA Assistant – ipa init --json (Paket 09 §4.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "runId",
    "ok",
    "exitCode",
    "outcome",
    "errors",
    "warnings",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "command": {
      "type": "string",
      "const": "init"
    },
    "runId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^R[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "ok": {
      "type": "boolean"
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "unchanged",
        "halted",
        "unstable",
        "lock_held",
        "analysis_failed",
        "outside_window",
        "usage_error",
        "error"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/runError"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/result"
        }
      ]
    }
  },
  "definitions": {
    "runError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created",
        "repositoryId",
        "repoPath",
        "workspacePath",
        "workspaceMode",
        "dataRoot",
        "timezone",
        "baselineSnapshotId",
        "baselineAdopted",
        "recovered",
        "claude"
      ],
      "properties": {
        "created": {
          "type": "boolean"
        },
        "repositoryId": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}-[0-9a-f]{6}$"
        },
        "repoPath": {
          "type": "string"
        },
        "workspacePath": {
          "type": "string"
        },
        "workspaceMode": {
          "type": "string",
          "enum": [
            "default",
            "explicit"
          ]
        },
        "dataRoot": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "baselineSnapshotId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^S[0-9]{6}$"
            }
          ]
        },
        "baselineAdopted": {
          "type": "boolean"
        },
        "recovered": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[0-9]{6}$"
          }
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checked",
            "ok",
            "cliVersion",
            "problems"
          ],
          "properties": {
            "checked": {
              "type": "boolean"
            },
            "ok": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "cliVersion": {
              "type": [
                "string",
                "null"
              ]
            },
            "problems": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
