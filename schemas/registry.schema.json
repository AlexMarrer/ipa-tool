{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPA Assistant – registry.json (spec.md §9.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositories"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repositoryId", "repoPath", "workspacePath", "workspaceMode", "createdAt"],
        "properties": {
          "repositoryId": { "type": "string", "pattern": "^[a-z0-9-]{1,32}-[0-9a-f]{6}$" },
          "repoPath": { "type": "string", "minLength": 1 },
          "workspacePath": { "type": "string", "minLength": 1 },
          "workspaceMode": { "type": "string", "enum": ["default", "explicit"] },
          "createdAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        }
      }
    }
  }
}
