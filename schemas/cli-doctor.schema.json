{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPA Assistant – ipa doctor --json (Paket 09 §4.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "runId",
    "ok",
    "exitCode",
    "outcome",
    "errors",
    "warnings",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "command": {
      "type": "string",
      "const": "doctor"
    },
    "runId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^R[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "ok": {
      "type": "boolean"
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "unchanged",
        "halted",
        "unstable",
        "lock_held",
        "analysis_failed",
        "outside_window",
        "usage_error",
        "error"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/runError"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/result"
        }
      ]
    }
  },
  "definitions": {
    "runError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live",
        "checkedAt",
        "ok",
        "git",
        "claude",
        "liveCheck",
        "liveCarriedOver",
        "missingFlags",
        "billing",
        "findings"
      ],
      "properties": {
        "live": {
          "type": "boolean"
        },
        "checkedAt": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "found",
            "version"
          ],
          "properties": {
            "found": {
              "type": "boolean"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "found",
            "version",
            "loggedIn",
            "authMethod",
            "flags",
            "settingSourcesAuthOk"
          ],
          "properties": {
            "found": {
              "type": "boolean"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "loggedIn": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "authMethod": {
              "type": [
                "string",
                "null"
              ]
            },
            "flags": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "settingSourcesAuthOk": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "liveCheck": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "checkedAt",
                "ok",
                "toolsReported",
                "mcpServersReported"
              ],
              "properties": {
                "checkedAt": {
                  "type": "string"
                },
                "ok": {
                  "type": "boolean"
                },
                "toolsReported": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "mcpServersReported": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "liveCarriedOver": {
          "type": "boolean"
        },
        "missingFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "billing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apiKeySources",
            "providerSources",
            "unreadableSettings",
            "detected",
            "allowPaidUsage",
            "blocked"
          ],
          "properties": {
            "apiKeySources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "providerSources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unreadableSettings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "detected": {
              "type": "boolean"
            },
            "allowPaidUsage": {
              "type": "boolean"
            },
            "blocked": {
              "type": "boolean"
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
