{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPA Assistant – state.json (spec.md §9.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryId",
    "baselineSnapshotId",
    "branch",
    "lastSnapshotId",
    "lastAnalysedSnapshotId",
    "lastCommit",
    "lastSuccessfulRun",
    "nextSnapshotSeq",
    "halt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "repositoryId": { "type": "string", "pattern": "^[a-z0-9-]{1,32}-[0-9a-f]{6}$" },
    "baselineSnapshotId": { "$ref": "#/definitions/snapshotIdOrNull" },
    "branch": { "type": ["string", "null"], "minLength": 1 },
    "lastSnapshotId": { "$ref": "#/definitions/snapshotIdOrNull" },
    "lastAnalysedSnapshotId": { "$ref": "#/definitions/snapshotIdOrNull" },
    "lastCommit": { "$ref": "#/definitions/commitOrNull" },
    "lastSuccessfulRun": { "$ref": "#/definitions/timestampOrNull" },
    "nextSnapshotSeq": { "type": "integer", "minimum": 1 },
    "halt": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reason", "detectedAt", "expected", "observed"],
      "properties": {
        "reason": { "type": "string", "enum": ["branch_changed", "history_rewritten", "head_missing"] },
        "detectedAt": { "$ref": "#/definitions/timestamp" },
        "expected": { "$ref": "#/definitions/position" },
        "observed": { "$ref": "#/definitions/position" }
      }
    }
  },
  "definitions": {
    "snapshotIdOrNull": { "type": ["string", "null"], "pattern": "^S[0-9]{6}$" },
    "commitOrNull": { "type": ["string", "null"], "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "timestampOrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "head"],
      "properties": {
        "branch": { "type": ["string", "null"], "minLength": 1 },
        "head": { "$ref": "#/definitions/commitOrNull" }
      }
    }
  }
}
