{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPA Assistant – Abschlussmarkierung analyses/<snapshotId>/complete.json (spec.md §9.8)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "completedAt", "analysisSha256", "logSha256"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "snapshotId": { "type": "string", "pattern": "^S[0-9]{6}$" },
    "completedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "analysisSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "logSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
